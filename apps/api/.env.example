# Copy to .env (never commit .env) and fill in the values.

# PostgreSQL connection string (Neon in cloud, a local Postgres on-prem)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Secret used to sign JWTs. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# development | production (production enables the secure cookie flag)
NODE_ENV=development

# Passwords for the seed users (pnpm db:seed). At least 12 chars each.
# Re-running the seed resets these users' passwords to the values below.
SEED_STUDENT_PASSWORD=
SEED_RECEPTION_PASSWORD=
SEED_ADMIN_PASSWORD=
