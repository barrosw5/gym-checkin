generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RECEPTION
  ADMIN
}

enum SessionMethod {
  SCREEN_QR
  RECEPTION_APPROVAL
  // Removed check-in method (no proof of presence); kept for old sessions
  SIMPLE
  MANUAL
}

// Ways a student can open a session (Strategy pattern in the API).
// Separate from SessionMethod: MANUAL is an admin correction, never something
// the residence can "enable", and SIMPLE only remains there for old sessions.
enum CheckinMethod {
  SCREEN_QR
  RECEPTION_APPROVAL
}

// Lifecycle of a check-in request (method B). Only PENDING can change.
enum CheckinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ClosedBy {
  USER
  RECEPTION
  AUTO
  ADMIN
}

model User {
  id                 String           @id @default(uuid())
  name               String
  room               String
  username           String           @unique
  passwordHash       String
  role               Role             @default(STUDENT)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  // Public demo account (credentials in the README): cannot change its
  // password, so no visitor can lock the others out
  isDemo             Boolean          @default(false)
  // Set for imported accounts (temporary password): the web app asks for a
  // new one before anything else
  mustChangePassword Boolean          @default(false)
  // Tokens issued before this instant are rejected (logs out other devices)
  passwordChangedAt  DateTime?
  sessions           Session[]
  // Two relations to CheckinRequest, so each needs a name
  checkinRequests    CheckinRequest[] @relation("RequestedBy")
  decidedRequests    CheckinRequest[] @relation("DecidedBy")
}

model Session {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id])
  entryAt  DateTime      @default(now())
  exitAt   DateTime?
  method   SessionMethod
  closedBy ClosedBy?

  // Time-range queries (reception "today", statistics). CHECK constraints
  // (exit after entry, closedBy set iff closed) live in the migrations.
  @@index([entryAt])
}

// A student asking reception to let them in (method B, ROADMAP 5.2).
// "One PENDING per user" is a partial unique index in the migration.
model CheckinRequest {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation("RequestedBy", fields: [userId], references: [id])
  createdAt   DateTime             @default(now())
  expiresAt   DateTime
  status      CheckinRequestStatus @default(PENDING)
  // Who at reception approved/rejected it (null while PENDING or EXPIRED)
  decidedById String?
  decidedBy   User?                @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?
}

// Singleton: exactly one row, id "global", created by a migration so every
// environment has it without running the seed. CHECK constraints in the
// migration enforce the single row and positive values.
model Settings {
  id              String          @id @default("global")
  capacity        Int             @default(10)
  autoCloseHours  Int             @default(2)
  enabledMethods  CheckinMethod[] @default([SCREEN_QR, RECEPTION_APPROVAL])
  qrWindowSeconds Int             @default(30)
}
