{
  "compilerOptions": {
    // Node ESM output: the strictest consumer (the API at runtime); Vite accepts it too
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "rootDir": "./src",
    "outDir": "./dist",
    // Emit .d.ts so the API and the web app get the types
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
